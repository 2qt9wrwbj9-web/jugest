{
  "renderReverseScreen": "  renderReverseScreen(){const j=this.bridge()?.getJudgeState?.()||{},machine=this.state.rev.machine||j.machine||'my';this.state.rev.machine=machine;let z=this.bridge()?.getReverseState?.(this.state.rev)||{},styles=this.bridge()?.getReverseStyles?.(machine)||[],pickup=this.bridge()?.getPickupState?.(machine)||this.state.pickup;this.state.pickup=pickup;return `<section class=\"workspace reverse-screen\"><button class=\"back-row\" type=\"button\" data-workspace=\"live\">‹ 実戦</button><div class=\"kicker\">LIVE</div><h1>後ヅモ</h1>${this.renderLiveTabs('rev')}<div class=\"rev-toolbar\"><label><small>機種</small><select data-rev-machine>${(z.machines||j.machines||[]).map(m=>`<option value=\"${esc(m.key)}\" ${m.key===machine?'selected':''}>${esc(m.name)}</option>`).join('')}</select></label><label><small>前任者</small><select data-rev-style>${styles.map(s=>`<option value=\"${esc(s.value)}\" ${s.value===this.state.rev.style?'selected':''}>${esc(s.label)}</option>`).join('')}</select></label></div><section class=\"rev-input panel\"><label><small>通常G</small><input data-rev-g type=\"number\" inputmode=\"numeric\" min=\"0\" value=\"${esc(this.state.rev.G)}\" placeholder=\"0\"></label><label><small>BB</small><input data-rev-b type=\"number\" inputmode=\"numeric\" min=\"0\" value=\"${esc(this.state.rev.B)}\" placeholder=\"0\"></label><label><small>RB</small><input data-rev-r type=\"number\" inputmode=\"numeric\" min=\"0\" value=\"${esc(this.state.rev.R)}\" placeholder=\"0\"></label><label><small>差枚</small><input data-rev-d type=\"number\" inputmode=\"numeric\" value=\"${esc(this.state.rev.D)}\" placeholder=\"+1200\"></label></section><section class=\"judge-result panel rev-result\"><div class=\"judge-result-top\"><div><small>期待設定</small><strong data-rev-es>${z.G?fmtES(z.expectedSetting):'—'}</strong></div><div class=\"judge-pills\"><span><small>4+</small><b data-rev-p4>${z.G?pct(z.p4):'—'}</b></span><span><small>5+</small><b data-rev-p5>${z.G?pct(z.p5):'—'}</b></span><span><small>6</small><b data-rev-p6>${z.G?pct(z.p6):'—'}</b></span></div></div><div class=\"rev-est\"><div><small>推定ぶどう</small><b data-rev-denom>${z.denom?'1/'+z.denom.toFixed(2):'—'}</b></div><div><small>推定回数</small><b data-rev-count>${z.estimatedCount!=null?z.estimatedCount+'回':'—'}</b></div></div><div class=\"judge-warning\" data-rev-warning ${z.warning?'':'hidden'}>${esc(z.warning||'')}</div></section>${pickup?this.renderPickupPanel(pickup):`<button class=\"primary-cta\" type=\"button\" data-pickup-begin ${!z.G?'disabled':''}>このデータから判別開始</button>`}</section>`}\n",
  "patchReverseResult": "  patchReverseResult(z){const r=this.shadowRoot,set=(sel,val)=>{const e=r.querySelector(sel);if(e)e.textContent=val};set('[data-rev-es]',z.G?fmtES(z.expectedSetting):'—');set('[data-rev-p4]',z.G?pct(z.p4):'—');set('[data-rev-p5]',z.G?pct(z.p5):'—');set('[data-rev-p6]',z.G?pct(z.p6):'—');set('[data-rev-denom]',z.denom?'1/'+z.denom.toFixed(2):'—');set('[data-rev-count]',z.estimatedCount!=null?z.estimatedCount+'回':'—');const w=r.querySelector('[data-rev-warning]');if(w){w.textContent=z.warning||'';w.hidden=!z.warning}const begin=r.querySelector('[data-pickup-begin]');if(begin)begin.disabled=!z.G||String(z.D??'').trim()===''}\n"
}
