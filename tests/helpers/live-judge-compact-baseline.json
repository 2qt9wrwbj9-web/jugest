{
  "renderJudgeScreen": "  renderJudgeScreen(){const j=this.state.judge||this.bridge()?.getJudgeState?.();if(!j)return `<section class=\"workspace\"><div class=\"error-panel\">判別状態を読み込めなかったよ。</div></section>`;this.state.judge=j;const groups=['small','big','reg'].filter(g=>j.defs.some(x=>x.group===g));return `<section class=\"workspace judge-screen\"><button class=\"back-row\" type=\"button\" data-workspace=\"live\">‹ 実戦</button><div class=\"kicker\">LIVE</div><h1>実戦判別</h1>${this.renderLiveTabs('judge')}<section class=\"judge-context\"><button type=\"button\" data-open-store-selector><small>店舗</small><b>${esc(j.context?.shopName||this.state.activeStore||'店舗を選択')}</b><span>⌄</span></button><label><small>日付</small><input type=\"date\" data-judge-date value=\"${esc(j.context?.date||'')}\"></label><label><small>台番</small><input inputmode=\"numeric\" data-judge-table value=\"${esc(j.context?.tableNo||'')}\" placeholder=\"例 412\"></label><label class=\"machine-select\"><small>機種</small><select data-judge-machine>${j.machines.map(m=>`<option value=\"${esc(m.key)}\" ${m.key===j.machine?'selected':''}>${esc(m.name)}</option>`).join('')}</select></label></section><section class=\"judge-result panel\"><div class=\"judge-result-top\"><div><small>期待設定</small><strong data-judge-es>${j.G?fmtES(j.expectedSetting):'—'}</strong></div><div class=\"judge-pills\"><span><small>設定4+</small><b data-judge-p4>${j.G?pct(j.p4):'—'}</b></span><span><small>設定5+</small><b data-judge-p5>${j.G?pct(j.p5):'—'}</b></span><span><small>設定6</small><b data-judge-p6>${j.G?pct(j.p6):'—'}</b></span></div></div><div class=\"prob-strip\">${j.q.map((v,i)=>`<div><small>${i+1}</small><b data-judge-q=\"${i}\">${j.G?pct(v):'—'}</b></div>`).join('')}</div><div class=\"judge-warning\" data-judge-warning ${j.warning?'':'hidden'}>${esc(j.warning||'')}</div></section><section class=\"judge-g panel\"><label><span>通常G</span><input data-judge-g type=\"number\" inputmode=\"numeric\" min=\"0\" value=\"${j.G||''}\" placeholder=\"0\"></label></section>${groups.map(g=>`<section class=\"metric-group\"><div class=\"section-label\">${groupLabel(g)}</div><div class=\"metric-grid\">${j.defs.filter(x=>x.group===g).map(d=>`<article class=\"metric-card ${d.enabled?'':'off'}\"><div class=\"metric-head\"><b>${esc(d.name)}</b><label class=\"switch\"><input type=\"checkbox\" data-judge-enable=\"${esc(d.id)}\" ${d.enabled?'checked':''}><span></span></label></div><div class=\"metric-control\"><button type=\"button\" data-judge-step=\"${esc(d.id)}\" data-delta=\"-1\">−</button><input type=\"number\" min=\"0\" inputmode=\"numeric\" data-judge-metric=\"${esc(d.id)}\" value=\"${d.value||''}\" placeholder=\"0\"><button type=\"button\" data-judge-step=\"${esc(d.id)}\" data-delta=\"1\">＋</button></div></article>`).join('')}</div></section>`).join('')}<button class=\"primary-cta record-save-cta\" type=\"button\" data-record-save-current=\"judge\" ${!j.G?'disabled':''}>この判別を稼働記録へ</button></section>`}",
  "patchJudgeResult": "  patchJudgeResult(j){const root=this.shadowRoot;if(!root)return;const set=(sel,val)=>{const el=root.querySelector(sel);if(el)el.textContent=val};set('[data-judge-es]',j.G?fmtES(j.expectedSetting):'—');set('[data-judge-p4]',j.G?pct(j.p4):'—');set('[data-judge-p5]',j.G?pct(j.p5):'—');set('[data-judge-p6]',j.G?pct(j.p6):'—');j.q?.forEach((v,i)=>set(`[data-judge-q=\"${i}\"]`,j.G?pct(v):'—'));const w=root.querySelector('[data-judge-warning]');if(w){w.textContent=j.warning||'';w.hidden=!j.warning}const save=root.querySelector('[data-record-save-current=\"judge\"]');if(save)save.disabled=!j.G}\n",
  "hanaResultPanel": "  hanaResultPanel(h,mode='live'){const r=mode==='rev'?h?.reverseResult:h?.liveResult;if(!r){return `<section class=\"panel hana-result\"><div class=\"empty-card\">データを入れるとここに判別結果が出るよ。</div></section>`}const q=r.q||[],m=h.config||{},metrics=r.metrics||null,warnings=r.warnings||[];return `<section class=\"panel hana-result\"><div class=\"judge-result-top\"><div><small>期待設定</small><strong data-hana-es>${metrics?fmtES(metrics.expectedSetting):'—'}</strong></div><div class=\"judge-pills\"><span><small>設定4+</small><b data-hana-p4>${metrics?pct(metrics.p4):'—'}</b></span><span><small>${m.labels?.at(-1)==='V'?'設定V':'最上位'}</small><b data-hana-top>${metrics?pct(metrics.pTop):'—'}</b></span></div></div><div class=\"prob-strip hana-prob-strip\">${(m.labels||[]).map((label,i)=>`<div><small>${esc(label)}</small><b data-hana-q=\"${i}\">${q.length?pct(q[i]||0):'—'}</b></div>`).join('')}</div>${mode==='rev'?`<div class=\"hana-reverse-est\"><span><small>推定ベル</small><b data-hana-bell>${r.reverse&&Number.isFinite(r.reverse.inferredDenom)?'1/'+r.reverse.inferredDenom.toFixed(2):'—'}</b></span><span><small>推定回数</small><b data-hana-bell-count>${r.reverse&&Number.isFinite(r.reverse.inferredBell)?Math.round(r.reverse.inferredBell)+'回':'—'}</b></span></div>`:''}<div class=\"judge-warning\" data-hana-warning ${warnings.length?'':'hidden'}>${esc(warnings.join(' / '))}</div>${mode==='live'&&r.own?.factors?.length?`<details class=\"hana-factors\"><summary>使用した判別要素</summary>${r.own.factors.map(f=>`<div class=\"${f.used?'':'off'}\"><b>${esc(f.label)}</b><small>${esc(f.detail||'')}</small></div>`).join('')}</details>`:''}</section>`}",
  "patchHanaResult": "  patchHanaResult(scope='live'){const h=this.state.hana;if(!h||!this.shadowRoot)return;const r=scope==='rev'?h.reverseResult:h.liveResult,metrics=r?.metrics,q=r?.q||[];const set=(sel,val)=>{const el=this.shadowRoot.querySelector(sel);if(el)el.textContent=val};set('[data-hana-es]',metrics?fmtES(metrics.expectedSetting):'—');set('[data-hana-p4]',metrics?pct(metrics.p4):'—');set('[data-hana-top]',metrics?pct(metrics.pTop):'—');q.forEach((v,i)=>set(`[data-hana-q=\"${i}\"]`,pct(v)));if(scope==='rev'){set('[data-hana-bell]',r?.reverse&&Number.isFinite(r.reverse.inferredDenom)?'1/'+r.reverse.inferredDenom.toFixed(2):'—');set('[data-hana-bell-count]',r?.reverse&&Number.isFinite(r.reverse.inferredBell)?Math.round(r.reverse.inferredBell)+'回':'—')}const w=this.shadowRoot.querySelector('[data-hana-warning]');if(w){w.textContent=(r?.warnings||[]).join(' / ');w.hidden=!(r?.warnings||[]).length}if(scope==='live'){const save=this.shadowRoot.querySelector('[data-record-save-current=\"hana\"]');if(save)save.disabled=!r?.selfG}}\n",
  "renderHanaJudgeScreen": "  renderHanaJudgeScreen(){const h=this.state.hana||this.bridge()?.getHanaState?.();if(!h)return `<section class=\"workspace\"><div class=\"error-panel\">HANA判別状態を読み込めなかったよ。</div></section>`;this.state.hana=h;const s=h.session,m=h.config||{};if(!s)return `<section class=\"workspace hana-screen\"><button class=\"back-row\" type=\"button\" data-workspace=\"live\">‹ 実戦</button><div class=\"kicker\">HANA</div><h1>ハナハナ判別</h1><div class=\"hana-toolbar\">${this.renderHanaMachineSelect(h)}</div><div class=\"info-card\"><b>判別セッション未開始</b><span>0Gから始めるか、ハナハナ後ヅモで前任者データを入力してから開始できる。</span></div><div class=\"hana-actions\"><button class=\"primary-btn\" type=\"button\" data-hana-zero>0Gから判別開始</button><button class=\"secondary-btn\" type=\"button\" data-action=\"live-hana-pickup\">前任者データを入力</button></div></section>`;const side=(m.sideColors||[]),bigAfter=(m.bigAfterColors||[]),regAfter=(m.regAfterColors||[]);return `<section class=\"workspace hana-screen\"><button class=\"back-row\" type=\"button\" data-workspace=\"live\">‹ 実戦</button><div class=\"kicker\">HANA</div><h1>ハナハナ判別</h1><div class=\"hana-toolbar\">${this.renderHanaMachineSelect(h)}<div class=\"hana-session-meta\"><small>開始G</small><b>${formatCount(s.startG,'G')}</b></div></div>${this.hanaResultPanel(h,'live')}<section class=\"panel hana-basic-grid\"><label><small>現在G</small><input data-hana-field=\"currentG\" data-hana-scope=\"live\" type=\"number\" inputmode=\"numeric\" min=\"0\" value=\"${esc(s.currentG??'')}\" placeholder=\"0\"></label><label><small>着席後BIG</small><input data-hana-field=\"bb\" data-hana-scope=\"live\" type=\"number\" inputmode=\"numeric\" min=\"0\" value=\"${esc(s.bb??'')}\" placeholder=\"0\"></label><label><small>着席後REG</small><input data-hana-field=\"rb\" data-hana-scope=\"live\" type=\"number\" inputmode=\"numeric\" min=\"0\" value=\"${esc(s.rb??'')}\" placeholder=\"0\"></label><label><small>実測ベル</small><input data-hana-field=\"bell\" data-hana-scope=\"live\" type=\"number\" inputmode=\"numeric\" min=\"0\" value=\"${esc(s.bell??'')}\" placeholder=\"未入力可\"></label></section><details class=\"hana-detail\" open><summary>BIG中小役</summary><div class=\"metric-grid\">${this.hanaCounter('対象G','bigGames',s.bigGames)}${this.hanaCounter('スイカ','bigWater',s.bigWater)}${this.hanaCounter('ハズレ','bigMiss',s.bigMiss)}</div></details><details class=\"hana-detail\"><summary>${esc(m.sideContext||'サイドランプ')}</summary><div class=\"metric-grid\">${side.map((c,i)=>this.hanaCounter(c,`sideCounts.${i}`,s.sideCounts?.[i]||'')).join('')}</div></details><details class=\"hana-detail\"><summary>${esc(m.bigAfterName||'BIG後ランプ')}</summary><div class=\"hana-basic-grid compact\"><label><small>対象BIG回数</small><input data-hana-field=\"normalBigTrials\" data-hana-scope=\"live\" type=\"number\" inputmode=\"numeric\" min=\"0\" value=\"${esc(s.normalBigTrials??'')}\"></label><label class=\"hana-check\"><input type=\"checkbox\" data-hana-field=\"firstBigSeparated\" data-hana-scope=\"live\" ${s.firstBigSeparated?'checked':''}><span>設定変更後の初回BIGを別カウント</span></label></div><div class=\"metric-grid\">${bigAfter.map((c,i)=>this.hanaCounter(c,`bigAfterCounts.${i}`,s.bigAfterCounts?.[i]||'')).join('')}</div></details><details class=\"hana-detail\"><summary>REG後ランプ</summary><div class=\"metric-grid\">${regAfter.map((c,i)=>this.hanaCounter(c,`regAfterCounts.${i}`,s.regAfterCounts?.[i]||'')).join('')}</div></details><details class=\"hana-detail\"><summary>レトロサウンド${m.regWater?' / REG中スイカ':''}</summary><div class=\"metric-grid\">${this.hanaCounter('条件達成','retroTrials',s.retroTrials)}${this.hanaCounter('レトロ発生','retroHits',s.retroHits)}${m.regWater?this.hanaCounter('REG中対象G','regGames',s.regGames):''}${m.regWater?this.hanaCounter('REG中スイカ','regWater',s.regWater):''}</div></details><div class=\"hana-actions\"><button class=\"secondary-btn\" type=\"button\" data-hana-reset=\"live\">判別セッション終了</button><button class=\"primary-btn\" type=\"button\" data-record-save-current=\"hana\" ${!h.liveResult?.selfG?'disabled':''}>この判別を稼働記録へ</button></div></section>`}"
}
