[Unit]
Description=JUGEST safe pull deploy
After=network-online.target jugest-web.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
Environment=JUGEST_DEPLOY_ROOT=/opt/jugest
Environment=JUGEST_DEPLOY_STATE_DIR=/var/lib/jugest-deploy
ExecStart=/usr/bin/flock -n /run/jugest-deploy.lock /usr/bin/node /opt/jugest/deployer/scripts/deploy-vps.mjs
TimeoutStartSec=15min
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/opt/jugest /var/lib/jugest-deploy /run
